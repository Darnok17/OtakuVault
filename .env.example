DATABASE_URL=postgres://otaku:otaku@localhost:5432/otakuvault

# Generate with: openssl rand -hex 16
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# OAuth (optional — leave blank to disable a provider)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AniList GraphQL endpoint (optional — defaults to https://graphql.anilist.co; point at a mock for offline testing)
ANILIST_API_URL=

# Public site origin (build-time; metadataBase, sitemap, robots). Production builds default to https://otakuvault.app
NEXT_PUBLIC_SITE_URL=

# Image storage driver: local (dev default) | blob (Vercel, until cutover) | r2 (Cloudflare; set in wrangler.jsonc)
STORAGE_DRIVER=
# r2 driver only: public origin of the MEDIA bucket, and its host for client code (defaults to img.otakuvault.app)
MEDIA_BASE_URL=
NEXT_PUBLIC_MEDIA_HOST=

# Vercel Blob (blob driver only; remove after the Cloudflare cutover)
VERCEL_BLOB_READ_WRITE_TOKEN=

# Set to 1 to expose wrangler.jsonc bindings (R2, Images, Hyperdrive) to `next dev` via a local miniflare
CF_DEV_BINDINGS=

# Bearer token for scheduled jobs (/api/jobs/new-episodes). Generate with: openssl rand -hex 32
CRON_SECRET=
